diff --git a/droidvm-shim/.cargo/config.toml b/droidvm-shim/.cargo/config.toml
index c5e673d..69dbd6a 100644
--- a/droidvm-shim/.cargo/config.toml
+++ b/droidvm-shim/.cargo/config.toml
@@ -18,3 +18,15 @@ rustflags = [
     "-C", "relocation-model=static",
     "-C", "force-frame-pointers=yes",
 ]
+
+# Local build (the prebuilt Android Rust has no aarch64-unknown-none-softfloat std and no rust-lld):
+# plain aarch64-unknown-none with NEON disabled, linked by the clang prebuilt's ld.lld.
+[target.aarch64-unknown-none]
+rustflags = [
+    "-C", "link-arg=-Tshim.ld",
+    "-C", "link-arg=-no-pie",
+    "-C", "relocation-model=static",
+    "-C", "force-frame-pointers=yes",
+    "-C", "target-feature=-neon",
+    "-C", "linker=/aosp/prebuilts/clang/host/linux-x86/clang-r563880c/bin/ld.lld",
+]
